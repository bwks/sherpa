<domain type='kvm'>
  <name>{{ name }}</name>
  <memory unit='MiB'>{{ memory_mib }}</memory>
  <vcpu>{{ vcpus }}</vcpu>

  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <kernel>{{ kernel }}</kernel>
    <cmdline>{{ cmdline }}</cmdline>
  </os>

  <features>
    <acpi/>
  </features>

  <cpu mode='host-passthrough'/>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>

  <devices>

    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='{{ disk }}'/>
      <target dev='vda' bus='virtio'/>
    </disk>

    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='{{ docker_disk }}'/>
      <target dev='vdb' bus='virtio'/>
    </disk>

    {% if let Some(archive) = image_archive %}
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw'/>
      <source file='{{ archive }}'/>
      <target dev='vdc' bus='virtio'/>
      <serial>{{ crate::node_vm::NODE_VM_IMAGE_ARCHIVE_SERIAL }}</serial>
      <readonly/>
    </disk>
    {% endif %}

    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='{{ config_drive }}'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>

    {% if let Some(management) = management %}
    <interface type='network'>
      <mac address='{{ management.mac }}'/>
      <source network='{{ management.network }}'/>
      <model type='virtio'/>
    </interface>
    {% endif %}

    {% for nic in nics %}
    {%   if let Some(bridge) = nic.bridge %}
    <interface type='bridge'>
      <mtu size='{{ shared::konst::MTU_JUMBO_NET }}'/>
      <mac address='{{ nic.mac }}'/>
      <source bridge='{{ bridge }}'/>
      <target dev='{{ nic.tap }}'/>
      <model type='virtio'/>
    </interface>
    {%   else %}
    <interface type='ethernet'>
      <mtu size='{{ shared::konst::MTU_JUMBO_NET }}'/>
      <mac address='{{ nic.mac }}'/>
      <target dev='{{ nic.tap }}'/>
      <script path=''/>
      <model type='virtio'/>
    </interface>
    {%   endif %}
    {% endfor %}

    <channel type='unix'>
      <source mode='bind' path='{{ status_socket }}'/>
      <target type='virtio' name='{{ crate::node_vm::NODE_VM_STATUS_CHANNEL }}'/>
    </channel>

    {% if let Some(socket) = serial_socket %}
    <serial type='unix'>
      <source mode='bind' path='{{ socket }}'/>
      <target type='isa-serial' port='0'/>
    </serial>

    <console type='unix'>
      <source mode='bind' path='{{ socket }}'/>
      <target type='serial' port='0'/>
    </console>
    {% endif %}

    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>

    <video>
      <model type='none'/>
    </video>

    <memballoon model='none'/>

  </devices>
</domain>
