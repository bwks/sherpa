<?xml version="1.0"?>

<domain xmlns:ns0="http://libvirt.org/schemas/domain/qemu/1.0" type="kvm">
  <name>{{ name }}</name>

  <vcpu placement='static'>{{ cpu_count }}</vcpu>
  {% if tuning.io_thread_cpuset.is_some() %}
  <iothreads>1</iothreads>
  {% endif %}
  {% if tuning.has_cputune() %}
  <cputune>
    {% for cpu in tuning.cpu_pinning %}
    <vcpupin vcpu='{{ loop.index0 }}' cpuset='{{ cpu }}'/>
    {% endfor %}
    {% if let Some(cpuset) = tuning.qemu_cpuset %}
    <emulatorpin cpuset='{{ cpuset }}'/>
    {% endif %}
    {% if let Some(cpuset) = tuning.io_thread_cpuset %}
    <iothreadpin iothread='1' cpuset='{{ cpuset }}'/>
    {% endif %}
  </cputune>
  {% endif %}

  <memory unit='MiB'>{{ memory }}</memory>
  {% if let Some(node) = tuning.numa_node %}
  <numatune>
    <memory mode='strict' nodeset='{{ node }}'/>
  </numatune>
  {% endif %}

  <resource>
    <partition>/machine</partition>
  </resource>

  <features>
    <acpi/>
    <apic/>
    <pae/>
    {% if is_windows %}
    <hyperv mode='custom'>
      <relaxed state='on'/>
      <vapic state='on'/>
      <spinlocks state='on' retries='8191'/>
      <vpindex state='on'/>
      <runtime state='on'/>
      <synic state='on'/>
      <stimer state='on'/>
      <frequencies state='on'/>
      <tlbflush state='on'/>
      <ipi state='on'/>
    </hyperv>
    {% endif %}
  </features>

  {% match cpu_model %}
  {%   when CpuModels::HostModel %}
  <cpu mode='{{ cpu_model }}'>
  {%   when CpuModels::HostPassthrough %}
  <cpu mode='{{ cpu_model }}'>
  {%   else %}
  <!-- Match any other cpu model -->
  <cpu>
    <model>{{ cpu_model }}</model>
  {% endmatch %}
    {% if let Some(topology) = tuning.cpu_topology %}
    <topology sockets='{{ topology.sockets }}' dies='1' cores='{{ topology.cores }}' threads='{{ topology.threads }}'/>
    {% endif %}
    {% if vmx_enabled %}
    <feature name="vmx" policy="require"/>
    {% endif %}
    {% for feat in cpu_features %}
    <feature name="{{ feat.name }}" policy="{{ feat.policy }}"/>
    {% endfor %}
  </cpu>

  {% if is_windows %}
  <clock offset='localtime'>
    <timer name='hypervclock' present='yes'/>
    <timer name='hpet' present='no'/>
  </clock>
  {% else %}
  <clock offset='utc'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
  </clock>
  {% endif %}

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>

  <os>
    <type arch='{{ cpu_architecture }}' machine='{{ machine_type }}'>hvm</type>
    <bootmenu enable='no'/>
    <smbios mode='sysinfo'/>
    <boot dev='cdrom'/>
    <boot dev='hd'/>
    {% match bios %}
    {%   when BiosTypes::Uefi %}
    <loader readonly='yes' type='pflash'>/usr/share/OVMF/OVMF_CODE_4M.fd</loader>
    <nvram>/var/lib/libvirt/qemu/nvram/{{ name|uppercase }}_VARS.fd</nvram>
    {%   when BiosTypes::SeaBios %}
    <!-- SeaBios - No stanza required -->
    {% endmatch %}
  </os>

  <sysinfo type='smbios'>
    <system>
      <entry name='serial'>ds=nocloud</entry>
    </system>
  </sysinfo>

  <pm>
    <suspend-to-mem enabled='no'/>
    <suspend-to-disk enabled='no'/>
  </pm>

  {% for cmd in qemu_commands %}
  <ns0:commandline>
    <ns0:arg value='{{ cmd.param }}'/>
    <ns0:arg value='{{ cmd.value }}'/>
  </ns0:commandline>
  {% endfor %}

  <devices>

    <emulator>{{ qemu_bin }}</emulator>

    {% for disk in disks %}
    {%   match disk.target_bus %}
    {%     when DiskBuses::Usb %}
    <disk type='file' device='disk'>
      <driver name='{{ disk.driver_name }}' type='{{ disk.driver_format }}'/>
      <source file='{{ disk.src_file }}'/>
      <target dev='{{ disk.target_dev }}' bus='{{ disk.target_bus }}' removable='on'/>
      <address type='usb'/>
    </disk>
    {%     else %}
    {%       match disk.disk_device %}
    {%         when DiskDevices::Cdrom %}

    <disk type='file' device='cdrom'>
      <driver name='{{ disk.driver_name }}' type='{{ disk.driver_format }}'/>
      <source file='{{ disk.src_file }}'/>
      <target dev='{{ disk.target_dev }}' bus='{{ disk.target_bus }}'/>
      <readonly/>
    </disk>
    {%         else %}
    <disk type='file' device='disk'>
      <driver name='{{ disk.driver_name }}' type='{{ disk.driver_format }}'{% if let Some(cache) = tuning.disk_cache %} cache='{{ cache }}'{% endif %}{% if let Some(io) = tuning.disk_io %} io='{{ io }}'{% endif %}{% if tuning.io_thread_cpuset.is_some() %} iothread='1'{% endif %}/>
      <source file='{{ disk.src_file }}'/>
      <target dev='{{ disk.target_dev }}' bus='{{ disk.target_bus }}'/>
    </disk>
    {%      endmatch %}
    {%   endmatch %}
    {% endfor %}

    <controller type='usb' index='0' model='qemu-xhci'>
      <alias name='usb'/>
    </controller>

    <graphics type='vnc' port='{{ vnc_port }}' autoport='no'/>
    <video>
      <model type='{{ video_model }}'{% match video_vram %}{% when Some with (vram) %} vram='{{ vram }}'{% when None %}{% endmatch %} heads='1'/>
    </video>

    {% for interface in interfaces %}
    {%   match interface.connection_type %}

    {%     when ConnectionTypes::Management %}
    <interface type='network'>
      <alias name='ua-net-{{ name }}-mgmt-{{ interface.name }}'/>
      <mtu size='{{ interface.mtu }}'/>
      <mac address='{{ interface.mac_address }}'/>
      <source network='{{ management_network }}'/>
      <model type='{{ management_interface_type }}'/>
      {% if let Some(queues) = tuning.management_interface_queues %}
      <driver queues='{{ queues }}'/>
      {% endif %}
    </interface>

    {%     when ConnectionTypes::Reserved %}
    <interface type='network'>
      <alias name='ua-net-{{ name }}-reserved-{{ interface.name }}'/>
      <mtu size='{{ interface.mtu }}'/>
      <mac address='{{ interface.mac_address }}'/>
      <source network='{{ reserved_network }}'/>
      <model type='{{ reserved_interface_type }}'/>
      <link state='up'/>
    </interface>

    {%     when ConnectionTypes::Disabled %}
    <interface type='network'>
      <alias name='ua-net-{{ name }}-disabled-{{ interface.name }}'/>
      <mtu size='{{ interface.mtu }}'/>
      <mac address='{{ interface.mac_address }}'/>
      <source network='{{ isolated_network }}'/>
      <model type='{{ interface_type }}'/>
      {% if let Some(queues) = tuning.interface_queues %}
      <driver queues='{{ queues }}'/>
      {% endif %}
      <link state='down'/>
    </interface>

    {%     when ConnectionTypes::PrivateBridge %}
    <interface type='bridge'>
      <alias name='ua-net-{{ name }}-shared-bridge-{{ interface.name }}'/>
      <mac address='{{ interface.mac_address }}'/>
      <source bridge='{{ interface.name }}'/>
      <model type='{{ interface_type }}'/>
      {% if let Some(queues) = tuning.interface_queues %}
      <driver queues='{{ queues }}'/>
      {% endif %}
    </interface>

    {%     when ConnectionTypes::P2p %}
    <interface type='ethernet'>
      <alias name='ua-net-{{ name }}-p2p-{{ interface.name }}'/>
      <mtu size='{{ interface.mtu }}'/>
      <mac address='{{ interface.mac_address }}'/>
      <target dev='{{ interface.name }}'/>
      <script path=''/>
      <model type='{{ interface_type }}'/>
      {% if let Some(queues) = tuning.interface_queues %}
      <driver queues='{{ queues }}'/>
      {% endif %}
    </interface>

    {%   endmatch %}
    {% endfor %}

    <serial type='tcp'>
      <source mode='bind' host='{{ loopback_ipv4 }}' service='{{ telnet_port }}'/>
      <protocol type='telnet'/>
      <target type='isa-serial' port='0'>
        <model name='isa-serial'/>
      </target>
      <alias name='serial0'/>
    </serial>

    <console type='tcp'>
      <source mode='bind' host='{{ loopback_ipv4 }}' service='{{ telnet_port }}'/>
      <protocol type='telnet'/>
      <target type='serial' port='0'/>
      <alias name='serial0'/>
    </console>

    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>

    {# <input type='mouse' bus='ps2'/>
    <input type='keyboard' bus='ps2'/> #}

    <memballoon model='virtio'>
    </memballoon>

    <watchdog model='i6300esb' action='reset'>
      <alias name='watchdog0'/>
    </watchdog>

  </devices>
</domain>
