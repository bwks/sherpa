#!/bin/bash
# Creates the node's container, starts it on every boot, and reports to sherpad how that went.
set -eEuo pipefail

API="http://docker/v{{ api_version }}"

source "{{ report }}"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Sends a request with method $2 to path $3 of the Engine API, with curl's arguments after it,
# and succeeds when Docker answers with one of the status codes in $1. Otherwise it prints
# Docker's message, or curl's when Docker did not answer, and fails.
docker_api() {
  local codes=$1 method=$2 path=$3 code message
  shift 3
  if ! code=$(curl --silent --show-error --unix-socket "{{ socket }}" --request "$method" \
    --output "$work/answer" --write-out '%{http_code}' "$@" "$API$path" 2> "$work/error"); then
    cat "$work/error"
    return 1
  fi
  if [[ " $codes " != *" $code "* ]]; then
    message=$(jq -r '.message // empty' "$work/answer" 2> /dev/null) || message=$(cat "$work/answer")
    echo "${message:-Docker answered $code}"
    return 1
  fi
}

# The milliseconds since $1, a value of EPOCHREALTIME.
elapsed_ms() {
  echo $(((${EPOCHREALTIME/./} - ${1/./}) / 1000))
}

name=$(cat "{{ container }}")
# Until the marker records a container made with its writable volumes, each boot makes it again.
if [ ! -e "{{ created }}" ]; then
  output=$(docker_api "204 404" DELETE "/containers/$name?force=true") ||
    fail "cannot remove the unfinished container: $output"
  begin=$EPOCHREALTIME
  output=$(docker_api 201 POST "/containers/create?name=$name" \
    --header "Content-Type: application/json" --data-binary "@{{ body }}") ||
    fail "cannot create the container: $output"
  echo "created the container in $(elapsed_ms "$begin") ms" >&2
  # The files and the empty folders only, made writable: the folders files go into keep their
  # owner and mode, and Docker makes any that are missing.
  stage="$work/stage"
  mkdir "$stage"
  while read -r source destination; do
    mkdir -p "$stage$(dirname "$destination")"
    cp -R "$source" "$stage$destination"
  done < "{{ writable }}"
  chmod -R u+w "$stage"
  begin=$EPOCHREALTIME
  if ! output=$( (cd "$stage" && find . \( -type f -o -type d -empty \) -print0 |
    tar --null --no-recursion --owner=0 --group=0 -cf - -T - |
    docker_api 200 PUT "/containers/$name/archive?path=/" \
      --header "Content-Type: application/x-tar" --data-binary @-) 2>&1); then
    docker_api "204 404" DELETE "/containers/$name?force=true" > /dev/null 2>&1 || true
    fail "cannot copy the writable volumes into the container: $output"
  fi
  echo "copied the writable volumes into the container in $(elapsed_ms "$begin") ms" >&2
  mkdir -p "$(dirname "{{ created }}")"
  touch "{{ created }}"
  sync
fi
# Docker answers 304 when its restart policy has already started the container.
output=$(docker_api "204 304" POST "/containers/$name/start") ||
  fail "cannot start the container: $output"
report started || true
