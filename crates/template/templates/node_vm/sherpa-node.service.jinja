[Unit]
Description=The node's container
Requires=docker.service {{ crate::node_vm::LINKS_UNIT }}
After=docker.service {{ crate::node_vm::LINKS_UNIT }}
RequiresMountsFor={{ crate::node_vm::NODE_VM_CONFIG_DRIVE_MOUNT }}

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{ crate::node_vm::NODE_SCRIPT_PATH }}

[Install]
WantedBy=multi-user.target

