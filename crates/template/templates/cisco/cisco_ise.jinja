# Mandatory networking
hostname={{ hostname }}

ipv4_addr={{ mgmt_ipv4_address }}
ipv4_mask={{ mgmt_ipv4.subnet_mask }}
ipv4_default_gw={{ mgmt_ipv4.first }}

# Optional IPv6
{%- if let Some(mgmt_ipv6_address) = mgmt_ipv6_address %}{% if let Some(mgmt_ipv6) = mgmt_ipv6 %}
ipv6_addr={{ mgmt_ipv6_address }}/{{ mgmt_ipv6.prefix_length }}
ipv6_default_gw={{ mgmt_ipv6.first }}
{%- endif %}{% endif %}

# DNS and domain
domain={{ dns.domain }}
primary_nameserver={{ mgmt_ipv4.boot_server }}

# NTP
primary_ntpserver=time.cloudflare.com
# secondary_ntpserver=pool.ntp.org

# Timezone (TZ string as in Linux)
timezone=UTC

# services - optional
ssh=true
ers=true
openapi=true
pxgrid=true

# Admin credentials
username={{ owner.username }}
password={{ owner.password }}
{%- for key in owner.ssh_keys %}
{%- if loop.first %}
# Optional SSH public key (ISE 3.2+)
public_key={{ key.kind }} {{ key.value }}
{%- endif %}
{%- endfor %}

# Skipping specific checks
SkipIcmpChecks=true
SkipDnsChecks=true
SkipNtpChecks=true