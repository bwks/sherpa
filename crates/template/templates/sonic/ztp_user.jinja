#!/bin/bash

# The owner logs in by key, or with their device password, set from its SHA-512-crypt hash.
/usr/sbin/useradd -m -s /bin/bash -G sudo,admin,docker {{ owner.username }}
/usr/bin/echo '{{ owner.username }}:{{ owner.password }}' | /usr/sbin/chpasswd -e
/usr/bin/mkdir -p /home/{{ owner.username }}/.ssh
/usr/bin/cat >/home/{{ owner.username }}/.ssh/authorized_keys <<'SHERPA_KEYS'
{%- for key in owner.ssh_keys %}
{{ key.kind }} {{ key.value }}
{%- endfor %}
SHERPA_KEYS
/usr/bin/chmod 700 /home/{{ owner.username }}/.ssh
/usr/bin/chmod 600 /home/{{ owner.username }}/.ssh/authorized_keys
/usr/bin/chown -R {{ owner.username }}:{{ owner.username }} /home/{{ owner.username }}
/usr/bin/echo '{{ owner.username }} ALL=(ALL) NOPASSWD: ALL' >/etc/sudoers.d/{{ owner.username }}
/usr/bin/chmod 440 /etc/sudoers.d/{{ owner.username }}

exit 0
