/system identity set name={{ hostname }}
/ip dns set servers={%- for server in dns.name_servers %}{{ server.ipv4_address }}{% if !loop.last %},{% endif %}{%- endfor %}
/user set 0 password={{ owner.password }}
:do { /user add name={{ owner.username }} password={{ owner.password }} group=full } on-error={}
{%- for key_file in owner_key_files %}
/user ssh-keys import public-key-file={{ key_file }} user={{ owner.username }}
{%- endfor %}
{%- if let Some(mgmt_ipv4_address) = mgmt_ipv4_address %}
/ip address add address={{ mgmt_ipv4_address }}/{{ mgmt_ipv4.prefix_length }} interface={{ mgmt_interface }}
{%- endif %}
/ip route add dst-address=0.0.0.0/0 gateway={{ mgmt_ipv4.first }}
{%- if let Some(mgmt_ipv6_address) = mgmt_ipv6_address %}{% if let Some(mgmt_ipv6) = mgmt_ipv6 %}
/ipv6 address add address={{ mgmt_ipv6_address }}/{{ mgmt_ipv6.prefix_length }} interface={{ mgmt_interface }}
/ipv6 route add dst-address=::/0 gateway={{ mgmt_ipv6.first }}
{%- endif %}{% endif %}
/ip service set ssh disabled=no
/ip service set telnet disabled=yes
/ip service set www disabled=yes
/ip service set api disabled=yes
/ip ssh set strong-crypto=yes