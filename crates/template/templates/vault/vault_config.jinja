storage "raft" {
  path       = "/vault/data"
  node_id = "{{ node_name }}"
}

listener "tcp" {
  address       = "0.0.0.0:{{ api_port }}"
  tls_cert_file = "{{ certs_dir }}/node.crt"
  tls_key_file  = "{{ certs_dir }}/node.key"
}

disable_mlock  = false
api_addr       = "https://{{ node_address }}:{{ api_port }}"
cluster_addr   = "https://{{ node_address }}:{{ cluster_port }}"
ui             = true