#!/bin/bash

# CUMULUS-AUTOPROVISIONING

function error() {
  echo -e "\e[0;33mERROR: The ZTP script failed while running the command $BASH_COMMAND at line $BASH_LINENO.\e[0m" >&2
  exit 1
}

# Log all output from this script
exec >> /var/log/autoprovision 2>&1
date "+%FT%T ztp starting script $0"

trap error ERR

#Configs
nv set system hostname {{ hostname }}
nv set service dns default search {{ dns.domain }}
{% for server in dns.name_servers %}
nv set service dns default server {{ server.ipv4_address }}
{% endfor %}
nv set system aaa user {{ owner.username }}
nv set system aaa user {{ owner.username }} password '{{ owner.password }}'
{%- for key in owner.ssh_keys %}
nv set system aaa user {{ owner.username }} ssh authorized-key {{ owner.username }}-ssh-key-{{ loop.index }} key {{ key.value }}
nv set system aaa user {{ owner.username }} ssh authorized-key {{ owner.username }}-ssh-key-{{ loop.index }} type {{ key.kind }}
{%- endfor %}
nv set system aaa user {{ owner.username }} role system-admin
nv unset interface eth0 ip address dhcp
nv set interface eth0 ip address {{ mgmt_ipv4_address }}/{{ mgmt_ipv4.prefix_length }}
nv set interface eth0 ip gateway {{ mgmt_ipv4.first }}
{%- if let Some(mgmt_ipv6_address) = mgmt_ipv6_address %}{% if let Some(mgmt_ipv6) = mgmt_ipv6 %}
nv set interface eth0 ip address {{ mgmt_ipv6_address }}/{{ mgmt_ipv6.prefix_length }}
nv set interface eth0 ip gateway {{ mgmt_ipv6.first }}
{%- endif %}{% endif %}

nv config apply --assume-yes --message "ZTP config"

exit 0