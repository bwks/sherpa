[Unit]
Description=Network OS console
Requires=docker.service
After=docker.service
StartLimitIntervalSec=0

[Service]
ExecStart={{ crate::flatcar_sandbox::CONSOLE_SCRIPT_PATH }}
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/{{ crate::flatcar_sandbox::SANDBOX_CONSOLE_TTY }}
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target

