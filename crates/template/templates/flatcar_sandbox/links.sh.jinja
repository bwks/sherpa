#!/bin/bash
# Names and addresses the VM's NICs for the network OS, before Docker starts the container.
set -eEu

WAIT_SECONDS=60
UNWIRED_NETNS=sherpa-unwired
SANDBOX_NETNS={{ crate::flatcar_sandbox::SANDBOX_NETNS }}

FAIL_PREFIX="interfaces: "
source {{ crate::flatcar_sandbox::REPORT_SCRIPT_PATH }}

# The name of the NIC with MAC $1, once the kernel has it.
nic_of() {
  local dev waited=0
  while [ "$waited" -lt "$WAIT_SECONDS" ]; do
    for dev in /sys/class/net/*; do
      if [ "$(cat "$dev/address")" = "$1" ]; then
        echo "${dev##*/}"
        return 0
      fi
    done
    sleep 1
    waited=$((waited + 1))
  done
  return 1
}

# Gives NIC $2, in network namespace $1 or the VM's own when $1 is empty, each address and default
# route of the `address/prefix gateway` lines on its input.
add_addresses() {
  local netns=() address gateway family nodad
  if [ -n "$1" ]; then
    netns=(-n "$1")
  fi
  while read -r address gateway; do
    case "$address" in
      *:*) family=-6 nodad=nodad ;;
      *) family=-4 nodad= ;;
    esac
    ip "${netns[@]}" "$family" addr replace "$address" dev "$2" ${nodad:+"$nodad"}
    ip "${netns[@]}" "$family" route replace default via "$gateway" dev "$2"
  done
}

# The sandbox's own NIC goes into a namespace the network OS does not see, before the other NICs
# are named, so none takes the name the kernel gave it.
read -r mac < {{ crate::flatcar_sandbox::SANDBOX_NIC_FILE }}
dev=$(nic_of "$mac") || fail "no NIC with MAC $mac for the sandbox after $WAIT_SECONDS seconds"
if [ ! -e "/run/netns/$SANDBOX_NETNS" ]; then
  ip netns add "$SANDBOX_NETNS"
fi
ip link set dev "$dev" down
ip link set dev "$dev" netns "$SANDBOX_NETNS"
ip -n "$SANDBOX_NETNS" link set dev "$dev" name {{ crate::flatcar_sandbox::SANDBOX_NIC }}
ip -n "$SANDBOX_NETNS" link set dev lo up
# Before it is up, so it never takes an address from a router advertisement.
ip netns exec "$SANDBOX_NETNS" sysctl -q -w \
  net.ipv6.conf.{{ crate::flatcar_sandbox::SANDBOX_NIC }}.accept_ra=0 \
  net.ipv6.conf.{{ crate::flatcar_sandbox::SANDBOX_NIC }}.autoconf=0
ip -n "$SANDBOX_NETNS" link set dev {{ crate::flatcar_sandbox::SANDBOX_NIC }} up
add_addresses "$SANDBOX_NETNS" {{ crate::flatcar_sandbox::SANDBOX_NIC }} < {{ crate::flatcar_sandbox::SANDBOX_NIC_ADDRESSES_FILE }}

# A temporary name first, so a NIC never takes a name another NIC still has.
index=0
while read -r mac want; do
  index=$((index + 1))
  dev=$(nic_of "$mac") || fail "no NIC with MAC $mac for $want after $WAIT_SECONDS seconds"
  ip link set dev "$dev" down
  ip addr flush dev "$dev"
  ip link set dev "$dev" name "sln$index"
done < {{ crate::flatcar_sandbox::INTERFACES_FILE }}
index=0
while read -r mac want; do
  index=$((index + 1))
  ip link set dev "sln$index" name "$want"
  ip link set dev "$want" up
done < {{ crate::flatcar_sandbox::INTERFACES_FILE }}

add_addresses "" {{ crate::flatcar_sandbox::SANDBOX_MANAGEMENT_INTERFACE }} < {{ crate::flatcar_sandbox::MANAGEMENT_FILE }}

# A data interface on no link is a veth whose peer stays down in a namespace of its own, so it
# has no carrier.
if [ ! -e "/run/netns/$UNWIRED_NETNS" ]; then
  ip netns add "$UNWIRED_NETNS"
fi
index=0
while read -r mac want; do
  index=$((index + 1))
  ip link add "$want" address "$mac" mtu {{ shared::konst::MTU_JUMBO_NET }} type veth \
    peer name "unw$index" mtu {{ shared::konst::MTU_JUMBO_NET }} netns "$UNWIRED_NETNS"
  ip link set dev "$want" up
done < {{ crate::flatcar_sandbox::PLACEHOLDERS_FILE }}

