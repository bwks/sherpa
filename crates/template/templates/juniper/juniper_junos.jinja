system {
    login {
        user {{ owner.username }} {
            class super-user;
            authentication {
                encrypted-password "{{ owner.password }}"; ## SECRET-DATA
                {%- for key in owner.ssh_keys %}
                {{ key.kind }} "{{ key.value }}"; ## SECRET-DATA
                {%- endfor %}
            }
        }
    }
    root-authentication {
        encrypted-password "{{ owner.password }}"; ## SECRET-DATA
    }
    host-name {{ hostname }};
    services {
        ssh {
            root-login allow;
        }
        netconf {
            ssh;
        }
    }
}
routing-options {
    static {
        route 0.0.0.0/0 next-hop {{ mgmt_ipv4.first }};
    }
    {%- if let Some(mgmt_ipv6_address) = mgmt_ipv6_address %}{% if let Some(mgmt_ipv6) = mgmt_ipv6 %}
    rib inet6.0 {
        static {
            route ::/0 next-hop {{ mgmt_ipv6.first }};
        }
    }
    {%- endif %}{% endif %}
}
interfaces {
    {{ mgmt_interface }} {
        unit 0 {
            family inet {
                {%- if let Some(mgmt_ipv4_address) = mgmt_ipv4_address %}
                address {{ mgmt_ipv4_address }}/{{ mgmt_ipv4.prefix_length }};
                {%- else %}
                dhcp;
                {%- endif %}
            }
            {%- if let Some(mgmt_ipv6_address) = mgmt_ipv6_address %}{% if let Some(mgmt_ipv6) = mgmt_ipv6 %}
            family inet6 {
                address {{ mgmt_ipv6_address }}/{{ mgmt_ipv6.prefix_length }};
            }
            {%- endif %}{% endif %}
        }
    }
}
protocols {
    lldp {
        interface all;
    }
}
