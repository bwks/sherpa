{% extends "layouts/base.html.jinja" %}

{% block title %}{{ config.model }} - Sherpa Labs{% endblock %}


{% block content %}
<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-3xl font-bold text-heading">{{ config.model }}</h2>
            <p class="mt-1 text-sm text-muted">Device template configuration details</p>
        </div>
        <div class="flex items-center space-x-3">
            <a href="/admin/images/{{ config.model }}/{{ config.version }}/edit" class="btn-edit">
                Edit Configuration
            </a>
            <a href="/admin/images/{{ config.model }}/versions" class="btn-outline">
                View All Versions
            </a>
            <a href="/admin/images" class="btn-ghost">
                ← Back to List
            </a>
        </div>
    </div>

    <!-- Basic Info Card -->
    <div class="bg-card rounded-lg shadow-sm border border-border p-6">
        <h3 class="text-lg font-semibold text-heading mb-4">Basic Information</h3>
        <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Model:</span>
                <span class="text-sm text-body font-medium font-mono">{{ config.model }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Kind:</span>
                <span class="text-sm text-body font-medium">
                    {% include "snippets/kind-badge.html.jinja" %}
                </span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Version:</span>
                <span class="text-sm text-body font-medium">{{ config.version }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Default:</span>
                <span class="text-sm text-body font-medium">
                    {% if config.default %}
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-success text-success-text">
                            Yes
                        </span>
                    {% else %}
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-neutral-badge text-neutral-badge-text">
                            No
                        </span>
                    {% endif %}
                </span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">OS Variant:</span>
                <span class="text-sm text-body font-medium">{{ config.os_variant }}</span>
            </div>
            {% if let Some(repo_value) = config.repo %}
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Repository:</span>
                <span class="text-sm text-body font-medium">{{ repo_value }}</span>
            </div>
            {% endif %}
        </div>
    </div>

    <!-- Hardware Card -->
    <div class="bg-card rounded-lg shadow-sm border border-border p-6">
        <h3 class="text-lg font-semibold text-heading mb-4">Hardware Configuration</h3>
        <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">CPU Count:</span>
                <span class="text-sm text-body font-medium">{{ config.cpu_count }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">CPU Architecture:</span>
                <span class="text-sm text-body font-medium">{{ config.cpu_architecture }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">CPU Model:</span>
                <span class="text-sm text-body font-medium">{{ config.cpu_model }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Memory:</span>
                <span class="text-sm text-body font-medium">{{ config.memory }} MB</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Machine Type:</span>
                <span class="text-sm text-body font-medium">{{ config.machine_type }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">BIOS:</span>
                <span class="text-sm text-body font-medium">{{ config.bios }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">VMX Enabled:</span>
                <span class="text-sm text-body font-medium">{% if config.vmx_enabled %}Yes{% else %}No{% endif %}</span>
            </div>
        </div>
    </div>

    <!-- Storage Card -->
    <div class="bg-card rounded-lg shadow-sm border border-border p-6">
        <h3 class="text-lg font-semibold text-heading mb-4">Storage Configuration</h3>
        <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">HDD Bus:</span>
                <span class="text-sm text-body font-medium">{{ config.hdd_bus }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">CD-ROM Bus:</span>
                <span class="text-sm text-body font-medium">{{ config.cdrom_bus }}</span>
            </div>
            {% if let Some(cdrom_value) = config.cdrom %}
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">CD-ROM:</span>
                <span class="text-sm text-body font-medium">{{ cdrom_value }}</span>
            </div>
            {% endif %}
        </div>
    </div>

    <!-- ZTP Configuration Card -->
    <div class="bg-card rounded-lg shadow-sm border border-border p-6">
        <h3 class="text-lg font-semibold text-heading mb-4">ZTP Configuration</h3>
        <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">ZTP:</span>
                <span class="text-sm text-body font-medium">{{ config.ztp.mode }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Password Auth:</span>
                <span class="text-sm text-body font-medium">{% if config.ztp.password_auth %}Enabled{% else %}Disabled{% endif %}</span>
            </div>
            {% if let Some(username_value) = config.ztp.username %}
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">ZTP Username:</span>
                <span class="text-sm text-body font-medium">{{ username_value }}</span>
            </div>
            {% endif %}
            {% if let Some(password_value) = config.ztp.password %}
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">ZTP Password:</span>
                <span class="text-sm text-body font-medium">{{ password_value }}</span>
            </div>
            {% endif %}
        </div>
    </div>

    <!-- Network Configuration Card -->
    <div class="bg-card rounded-lg shadow-sm border border-border p-6">
        <h3 class="text-lg font-semibold text-heading mb-4">Network Configuration</h3>
        <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Data Interfaces:</span>
                <span class="text-sm text-body font-medium">{{ config.data_interface_count }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Interface Prefix:</span>
                <span class="text-sm text-body font-medium font-mono">{{ config.interface_prefix }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Interface Type:</span>
                <span class="text-sm text-body font-medium">{{ config.interface_type }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Interface MTU:</span>
                <span class="text-sm text-body font-medium">{{ config.interface_mtu }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">First Interface Index:</span>
                <span class="text-sm text-body font-medium">{{ config.first_interface_index }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Management Interface:</span>
                <span class="text-sm text-body font-medium font-mono">{{ config.management_interface }}</span>
            </div>
            <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-muted uppercase tracking-wide">Reserved Interfaces:</span>
                <span class="text-sm text-body font-medium">{{ config.reserved_interface_count }}</span>
            </div>
        </div>
    </div>
</div>
{% endblock %}
