{% extends "layouts/base.html.jinja" %}

{% block title %}Edit {{ config.model }} - Sherpa Labs{% endblock %}


{% block content %}
<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-3xl font-bold text-heading">Edit {{ config.model }}</h2>
            <p class="mt-1 text-sm text-muted">Update device template configuration</p>
        </div>
        <a href="/admin/images/{{ config.model }}/{{ config.version }}" class="btn-ghost">
            ← Cancel
        </a>
    </div>

    <!-- Form Result Div for HTMX responses -->
    <div id="form-result"></div>

    <!-- Edit Form -->
    <form id="edit-form" hx-post="/admin/images/{{ config.model }}/{{ config.version }}/edit" hx-target="#form-result" hx-swap="innerHTML" class="space-y-6">

        <!-- Basic Information Card -->
        <div class="bg-card rounded-lg shadow-sm border border-border p-6">
            <h3 class="text-lg font-semibold text-heading mb-4">Basic Information</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Model (Read-only) -->
                <div>
                    <label class="block text-sm font-medium text-body mb-2">Model</label>
                    <input type="text" value="{{ config.model }}" disabled class="w-full px-3 py-2 border border-border-strong rounded-md bg-surface text-muted cursor-not-allowed">
                    <p class="mt-1 text-xs text-muted">Read-only identifier</p>
                </div>

                <!-- Kind (Read-only) -->
                <div>
                    <label class="block text-sm font-medium text-body mb-2">Kind</label>
                    <input type="text" value="{{ kind_label }}" disabled class="w-full px-3 py-2 border border-border-strong rounded-md bg-surface text-muted cursor-not-allowed">
                    <p class="mt-1 text-xs text-muted">Read-only identifier</p>
                </div>

                <!-- Version (Read-only) -->
                <div>
                    <label class="block text-sm font-medium text-body mb-2">Version</label>
                    <input type="text" name="version" value="{{ config.version }}" readonly class="w-full px-3 py-2 border border-border-strong rounded-md bg-surface text-muted cursor-not-allowed">
                    <p class="mt-1 text-xs text-muted">Read-only identifier</p>
                </div>

                <!-- Default Checkbox -->
                <div class="flex items-center">
                    <input type="checkbox" id="default" name="default" {% if config.default %}checked{% endif %} class="h-4 w-4 text-accent focus:ring-accent border-border-strong rounded">
                    <label for="default" class="ml-2 block text-sm font-medium text-body">Set as Default Version</label>
                </div>

                <!-- OS Variant -->
                <div>
                    <label for="os_variant" class="block text-sm font-medium text-body mb-2">OS Variant *</label>
                    <select id="os_variant" name="os_variant" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                        {% for choice in os_variant_choices %}
                        <option value="{{ choice.value }}" {% if choice.selected %}selected{% endif %}>{{ choice.label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Repository -->
                <div class="md:col-span-2">
                    <label for="repo" class="block text-sm font-medium text-body mb-2">Repository</label>
                    {% match config.repo %}
                    {% when Some with (repo_value) %}
                    <input type="text" id="repo" name="repo" value="{{ repo_value }}" class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                    {% when None %}
                    <input type="text" id="repo" name="repo" value="" class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                    {% endmatch %}
                    <p class="mt-1 text-xs text-muted">Optional software repository URL</p>
                </div>
            </div>
        </div>

        <!-- Hardware Configuration Card -->
        <div class="bg-card rounded-lg shadow-sm border border-border p-6">
            <h3 class="text-lg font-semibold text-heading mb-4">Hardware Configuration</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- CPU Count -->
                <div>
                    <label for="cpu_count" class="block text-sm font-medium text-body mb-2">CPU Count *</label>
                    <input type="number" id="cpu_count" name="cpu_count" value="{{ config.cpu.count }}" min="1" max="255" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                    <p class="mt-1 text-xs text-muted">Range: 1-255</p>
                </div>

                <!-- CPU Architecture -->
                <div>
                    <label for="cpu_architecture" class="block text-sm font-medium text-body mb-2">CPU Architecture *</label>
                    <select id="cpu_architecture" name="cpu_architecture" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                        {% for choice in cpu_architecture_choices %}
                        <option value="{{ choice.value }}" {% if choice.selected %}selected{% endif %}>{{ choice.label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- CPU Model -->
                <div>
                    <label for="cpu_model" class="block text-sm font-medium text-body mb-2">CPU Model *</label>
                    <select id="cpu_model" name="cpu_model" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                        {% for choice in cpu_model_choices %}
                        <option value="{{ choice.value }}" {% if choice.selected %}selected{% endif %}>{{ choice.label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Memory -->
                <div>
                    <label for="memory" class="block text-sm font-medium text-body mb-2">Memory (MB) *</label>
                    <input type="number" id="memory" name="memory" value="{{ config.memory }}" min="64" max="65535" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                    <p class="mt-1 text-xs text-muted">Range: 64-65535 MB</p>
                </div>

                <!-- Machine Type -->
                <div>
                    <label for="machine_type" class="block text-sm font-medium text-body mb-2">Machine Type *</label>
                    <select id="machine_type" name="machine_type" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                        {% for choice in machine_type_choices %}
                        <option value="{{ choice.value }}" {% if choice.selected %}selected{% endif %}>{{ choice.label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- BIOS -->
                <div>
                    <label for="bios" class="block text-sm font-medium text-body mb-2">BIOS Type *</label>
                    <select id="bios" name="bios" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                        {% for choice in bios_choices %}
                        <option value="{{ choice.value }}" {% if choice.selected %}selected{% endif %}>{{ choice.label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- VMX Enabled -->
                <div class="flex items-center">
                    <input type="checkbox" id="vmx_enabled" name="vmx_enabled" {% if config.cpu.vmx %}checked{% endif %} class="h-4 w-4 text-accent focus:ring-accent border-border-strong rounded">
                    <label for="vmx_enabled" class="ml-2 block text-sm font-medium text-body">Enable VMX (Nested Virtualization)</label>
                </div>
            </div>
        </div>

        <!-- Storage Configuration Card -->
        <div class="bg-card rounded-lg shadow-sm border border-border p-6">
            <h3 class="text-lg font-semibold text-heading mb-4">Storage Configuration</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- HDD Bus -->
                <div>
                    <label for="hdd_bus" class="block text-sm font-medium text-body mb-2">HDD Bus *</label>
                    <select id="hdd_bus" name="hdd_bus" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                        {% for choice in hdd_bus_choices %}
                        <option value="{{ choice.value }}" {% if choice.selected %}selected{% endif %}>{{ choice.label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- CD-ROM Bus -->
                <div>
                    <label for="cdrom_bus" class="block text-sm font-medium text-body mb-2">CD-ROM Bus *</label>
                    <select id="cdrom_bus" name="cdrom_bus" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                        {% for choice in cdrom_bus_choices %}
                        <option value="{{ choice.value }}" {% if choice.selected %}selected{% endif %}>{{ choice.label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- CD-ROM -->
                <div class="md:col-span-2">
                    <label for="cdrom" class="block text-sm font-medium text-body mb-2">CD-ROM Path</label>
                    {% match config.cdrom.image %}
                    {% when Some with (cdrom_value) %}
                    <input type="text" id="cdrom" name="cdrom" value="{{ cdrom_value }}" class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                    {% when None %}
                    <input type="text" id="cdrom" name="cdrom" value="" class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                    {% endmatch %}
                    <p class="mt-1 text-xs text-muted">Optional CD-ROM image path</p>
                </div>
            </div>
        </div>

        <!-- ZTP Configuration Card -->
        <div class="bg-card rounded-lg shadow-sm border border-border p-6">
            <h3 class="text-lg font-semibold text-heading mb-4">ZTP Configuration</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- ZTP -->
                <div>
                    <label for="ztp" class="block text-sm font-medium text-body mb-2">ZTP *</label>
                    <select id="ztp" name="ztp" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                        {% for choice in ztp_choices %}
                        <option value="{{ choice.value }}" {% if choice.selected %}selected{% endif %}>{{ choice.label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- ZTP Password Auth -->
                <div class="flex items-center">
                    <input type="checkbox" id="ztp_password_auth" name="ztp_password_auth" {% if config.ztp.password_auth %}checked{% endif %} class="h-4 w-4 text-accent focus:ring-accent border-border-strong rounded">
                    <label for="ztp_password_auth" class="ml-2 block text-sm font-medium text-body">Password Authentication</label>
                </div>

                <!-- ZTP Username -->
                <div>
                    <label for="ztp_username" class="block text-sm font-medium text-body mb-2">ZTP Username</label>
                    {% match config.ztp.username %}
                    {% when Some with (username_value) %}
                    <input type="text" id="ztp_username" name="ztp_username" value="{{ username_value }}" class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                    {% when None %}
                    <input type="text" id="ztp_username" name="ztp_username" value="" class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                    {% endmatch %}
                </div>

                <!-- ZTP Password -->
                <div>
                    <label for="ztp_password" class="block text-sm font-medium text-body mb-2">ZTP Password</label>
                    {% match config.ztp.password %}
                    {% when Some with (password_value) %}
                    <input type="password" id="ztp_password" name="ztp_password" value="{{ password_value }}" class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                    {% when None %}
                    <input type="password" id="ztp_password" name="ztp_password" value="" class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                    {% endmatch %}
                </div>
            </div>
        </div>

        <!-- Network Configuration Card -->
        <div class="bg-card rounded-lg shadow-sm border border-border p-6">
            <h3 class="text-lg font-semibold text-heading mb-4">Network Configuration</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Data Interface Count -->
                <div>
                    <label for="data_interface_count" class="block text-sm font-medium text-body mb-2">Data Interface Count *</label>
                    <input type="number" id="data_interface_count" name="data_interface_count" value="{{ config.interfaces.data_count }}" min="0" max="255" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                    <p class="mt-1 text-xs text-muted">Range: 0-255</p>
                </div>

                <!-- Interface Prefix -->
                <div>
                    <label for="interface_prefix" class="block text-sm font-medium text-body mb-2">Interface Prefix *</label>
                    <input type="text" id="interface_prefix" name="interface_prefix" value="{{ config.interfaces.prefix }}" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                    <p class="mt-1 text-xs text-muted">e.g., eth, ens, enp</p>
                </div>

                <!-- Interface Type -->
                <div>
                    <label for="interface_type" class="block text-sm font-medium text-body mb-2">Interface Type *</label>
                    <select id="interface_type" name="interface_type" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                        {% for choice in interface_type_choices %}
                        <option value="{{ choice.value }}" {% if choice.selected %}selected{% endif %}>{{ choice.label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Interface MTU -->
                <div>
                    <label for="interface_mtu" class="block text-sm font-medium text-body mb-2">Interface MTU *</label>
                    <input type="number" id="interface_mtu" name="interface_mtu" value="{{ config.interfaces.mtu }}" min="576" max="9600" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                    <p class="mt-1 text-xs text-muted">Range: 576-9600</p>
                </div>

                <!-- First Interface Index -->
                <div>
                    <label for="first_interface_index" class="block text-sm font-medium text-body mb-2">First Interface Index *</label>
                    <input type="number" id="first_interface_index" name="first_interface_index" value="{{ config.interfaces.first_index }}" min="0" max="255" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                </div>

                <!-- Reserved Interface Count -->
                <div>
                    <label for="reserved_interface_count" class="block text-sm font-medium text-body mb-2">Reserved Interface Count *</label>
                    <input type="number" id="reserved_interface_count" name="reserved_interface_count" value="{{ config.interfaces.reserved_count }}" min="0" max="255" required class="w-full px-3 py-2 border border-border-strong rounded-md focus:ring-accent focus:border-accent bg-card text-heading">
                </div>

                <!-- Management Interface (Read-only) -->
                <div>
                    <label for="management_interface" class="block text-sm font-medium text-body mb-2">Management Interface</label>
                    <input type="text" value="{{ config.interfaces.management }}" disabled class="w-full px-3 py-2 border border-border-strong rounded-md bg-surface text-muted cursor-not-allowed">
                    <p class="mt-1 text-xs text-muted">Read-only identifier</p>
                </div>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="flex items-center justify-end space-x-4 bg-card rounded-lg shadow-sm border border-border p-6">
            <a href="/admin/images/{{ config.model }}/{{ config.version }}" class="btn-cancel">
                Cancel
            </a>
            <button type="submit" class="btn-primary">
                Save Changes
            </button>
        </div>
    </form>
</div>

<script src="/js/image-edit.js"></script>
{% endblock %}
