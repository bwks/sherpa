{# Node state badge (small — for table rows) #}
{% macro node_state(state) %}
    {% if state.to_string() == "running" %}
    <span class="badge-success">Running</span>
    {% elif state.to_string() == "building" || state.to_string() == "starting" %}
    <span class="badge-warning">{{ state.to_string()|capitalize }}</span>
    {% elif state.to_string() == "failed" || state.to_string() == "missing" %}
    <span class="badge-danger">{{ state.to_string()|capitalize }}</span>
    {% else %}
    <span class="badge-neutral">{{ state.to_string()|capitalize }}</span>
    {% endif %}
{% endmacro %}

{# Node state badge (large — for detail page headers) #}
{% macro node_state_lg(state) %}
    {% if state.to_string() == "running" %}
    <span class="badge-success-lg">Running</span>
    {% elif state.to_string() == "building" || state.to_string() == "starting" %}
    <span class="badge-warning-lg">{{ state.to_string()|capitalize }}</span>
    {% elif state.to_string() == "failed" || state.to_string() == "missing" %}
    <span class="badge-danger-lg">{{ state.to_string()|capitalize }}</span>
    {% else %}
    <span class="badge-neutral-lg">{{ state.to_string()|capitalize }}</span>
    {% endif %}
{% endmacro %}

{# Lab state badge (small — for table rows) #}
{% macro lab_state(state) %}
    {% if state.to_string() == "running" %}
    <span class="badge-success">Running</span>
    {% elif state.to_string() == "starting" || state.to_string() == "partial" %}
    <span class="badge-warning">{{ state.to_string()|capitalize }}</span>
    {% elif state.to_string() == "failed" %}
    <span class="badge-danger">Failed</span>
    {% elif state.to_string() == "stopped" %}
    <span class="badge-neutral">Stopped</span>
    {% else %}
    <span class="badge-neutral">{{ state.to_string()|capitalize }}</span>
    {% endif %}
{% endmacro %}

{# Lab phase badge: shown instead of the lab state while the lab is not ready #}
{% macro lab_phase(phase) %}
    {% if phase.to_string() == "creating" || phase.to_string() == "destroying" %}
    <span class="badge-warning">{{ phase.to_string()|capitalize }}</span>
    {% else %}
    <span class="badge-danger">{{ phase.to_string()|capitalize }}</span>
    {% endif %}
{% endmacro %}

{# Lab state badge (large — for detail page headers) #}
{% macro lab_state_lg(state) %}
    {% if state.to_string() == "running" %}
    <span class="badge-success-lg">Running</span>
    {% elif state.to_string() == "starting" || state.to_string() == "partial" %}
    <span class="badge-warning-lg">{{ state.to_string()|capitalize }}</span>
    {% elif state.to_string() == "failed" %}
    <span class="badge-danger-lg">Failed</span>
    {% elif state.to_string() == "stopped" %}
    <span class="badge-neutral-lg">Stopped</span>
    {% else %}
    <span class="badge-neutral-lg">{{ state.to_string()|capitalize }}</span>
    {% endif %}
{% endmacro %}

{# Lab phase badge (large — for detail page headers) #}
{% macro lab_phase_lg(phase) %}
    {% if phase.to_string() == "creating" || phase.to_string() == "destroying" %}
    <span class="badge-warning-lg">{{ phase.to_string()|capitalize }}</span>
    {% else %}
    <span class="badge-danger-lg">{{ phase.to_string()|capitalize }}</span>
    {% endif %}
{% endmacro %}
