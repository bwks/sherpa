#! /usr/bin/bash
#
# Enable with: git config core.hooksPath .githooks

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
"${root}/dev/check-lint-exceptions.sh"
"${root}/dev/check-doc-code-blocks.sh"
"${root}/dev/check-comment-issue-numbers.sh"
"${root}/dev/check-ebpf-unwrap.sh"
if ! command -v rusty-lints >/dev/null; then
    echo "rusty-lints not found: run mise install to add it to the pre-commit checks" >&2
    exit 1
fi
rusty-lints -C "${root}" scan
exec "${root}/dev/check-template-text-decisions.sh"
